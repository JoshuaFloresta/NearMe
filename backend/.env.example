# Local development port. Vercel supplies the runtime port automatically.
PORT=5000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=NearMe

# Comma-separated frontend origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173,https://your-nearme-frontend.vercel.app
FRONTEND_URL=https://your-nearme-frontend.vercel.app

JWT_SECRET=replace-with-a-long-random-secret

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Cashless payment (PayMongo)
PAYMONGO_SECRET_KEY=sk_test_or_live_replace_me
PAYMONGO_PAYMENT_METHOD_TYPES=qrph,gcash,paymaya,card
PAYMONGO_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# Required to create the first admin in a production database.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
